{
  "name": "pathway",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @pathway/api --filter @pathway/web dev",
    "dev:api": "pnpm --filter @pathway/api dev",
    "dev:web": "pnpm --filter @pathway/web dev",
    "worker": "pnpm --filter @pathway/api worker",
    "build": "pnpm --filter @pathway/api build && pnpm --filter @pathway/web build",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tsconfig.tests.json",
    "lint": "eslint apps packages tests scripts *.mjs *.ts --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @pathway/api db:generate",
    "db:migrate": "pnpm --filter @pathway/api db:migrate",
    "db:seed": "pnpm --filter @pathway/api db:seed",
    "test": "pnpm --filter @pathway/api test",
    "test:e2e": "playwright test",
    "api:generate": "node scripts/generate-client.mjs",
    "infra:up": "docker compose -f infra/compose.yaml up -d",
    "infra:down": "docker compose -f infra/compose.yaml down",
    "services:verify": "node scripts/verify-services.mjs",
    "recovery:verify": "node scripts/verify-recovery.mjs",
    "audit:production": "pnpm audit --prod --audit-level high",
    "load:verify": "node scripts/verify-load.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.4",
    "prettier": "^3.6.2",
    "@playwright/test": "^1.56.1",
    "@axe-core/playwright": "^4.11.0",
    "@types/node": "^24.10.0",
    "typescript": "5.9.3",
    "openapi-typescript": "^7.10.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "argon2",
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "@nestjs/platform-express>multer": "2.5.0",
      "@nestjs/swagger>js-yaml": "5.4.3",
      "@prisma/config@6.19.3>deepmerge-ts": "8.0.0"
    }
  }
}
