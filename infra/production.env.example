# Configuration checklist only. Replace every example before staging/production.
# Keep the actual file outside the checkout with access limited to operators.
# Refer to docs/operations.md for image and Compose interpolation variables.
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://runtime:REPLACE_WITH_URL_ENCODED_SECRET@private-db.example:5432/pathway?schema=public&connection_limit=10
WEB_ORIGIN=https://learn.example.org
DEFAULT_ORGANIZATION_ID=REPLACE_WITH_REAL_ORGANIZATION_ID
REDIS_URL=rediss://default:REPLACE_WITH_URL_ENCODED_SECRET@private-redis.example:6379
S3_ENDPOINT=https://private-s3.example.org
S3_PUBLIC_ENDPOINT=https://files.example.org
S3_ACCESS_KEY=REPLACE_WITH_RESTRICTED_BUCKET_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_SECRET
S3_BUCKET=pathway-private
S3_REGION=REPLACE_WITH_REGION
SMTP_HOST=smtp.example.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE_WITH_SERVICE_ACCOUNT
SMTP_PASSWORD=REPLACE_WITH_SECRET
MAIL_FROM="Pathway <learning@example.org>"
CLAMAV_HOST=private-clamav.example
CLAMAV_PORT=3310
SESSION_TTL_HOURS=24
AUTH_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Set 0..3 only after verifying the exact private proxy chain and stripping client-supplied forwarding headers at the edge.
TRUST_PROXY_HOPS=0
COOKIE_SECURE=true
MFA_ENCRYPTION_KEY=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS_FROM_32_RANDOM_BYTES
